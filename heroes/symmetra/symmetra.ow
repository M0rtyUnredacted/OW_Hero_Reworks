variables
{
    player:
        0: Surge_Active
        1: Surge_CD
        2: Surge_VFX
        3: Ult_Matrix_Active
        4: Aura_Buffed
        5: Bunker_Health_Pool
        6: Bunker_HoT
        7: Dmg_Acc
        8: Aura_Check
        9: Surge_Dur
}

rule("Init: System Variables & Disable Turrets")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    actions
    {
        Set Ability 1 Enabled(Event Player, False);
        Event Player.Surge_CD = 0;
        Event Player.Surge_Dur = 0;
        Event Player.Surge_Active = False;
        Event Player.Ult_Matrix_Active = False;
        Event Player.Dmg_Acc = 0;
        Chase Player Variable At Rate(Event Player, Surge_CD, 0, 1, Destination and Rate);
        Create HUD Text(Filtered Array(Array(Event Player), Event Player.Surge_Active == True), Custom String("*** SURGE: {0}s ***", Round To Integer(Event Player.Surge_Dur, Up)), Null, Null, Top, 1, Color(Yellow), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Filtered Array(Array(Event Player), And(Event Player.Surge_Active == False, Event Player.Surge_CD > 0)), Custom String("SURGE CD: {0}s", Round To Integer(Event Player.Surge_CD, Up)), Null, Null, Top, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Filtered Array(Array(Event Player), And(Event Player.Surge_Active == False, Event Player.Surge_CD <= 0)), Custom String("SURGE: READY"), Null, Null, Top, 1, Color(Green), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Custom String("COMBO: {0}/250", Round To Integer(Event Player.Dmg_Acc, Down)), Null, Null, Top, 2, Color(Green), Color(White), Color(White), Visible To and String, Default Visibility);
    }
}

rule("Passive: Shield Vampire (Combat CDR)")
{
    event
    {
        Player Dealt Damage;
        All;
        Symmetra;
    }

    actions
    {
        Event Player.Dmg_Acc += Event Damage;
        If(Event Player.Dmg_Acc >= 250);
            Event Player.Surge_CD -= 1;
            If(Ability Cooldown(Event Player, Button(Ability 2)) > 0);
                Set Ability Cooldown(Event Player, Button(Ability 2), Ability Cooldown(Event Player, Button(Ability 2)) - 1);
            End;
            Event Player.Dmg_Acc -= 250;
        End;
    }
}

rule("Ability 1: Surge (Self-Buff)")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    conditions
    {
        Is Button Held(Event Player, Button(Ability 1)) == True;
        Event Player.Surge_CD <= 0;
        Event Player.Ult_Matrix_Active == False;
    }

    actions
    {
        Event Player.Surge_Active = True;
        Event Player.Surge_CD = 14;
        Event Player.Surge_Dur = 6;
        Chase Player Variable At Rate(Event Player, Surge_Dur, 0, 1, Destination and Rate);
        Set Move Speed(Event Player, 130);
        Set Damage Dealt(Event Player, 130);
        Create Effect(All Players(All Teams), Sparkles, Color(Yellow), Event Player, 1.5, Visible To Position and Radius);
        Event Player.Surge_VFX = Last Created Entity;
        Wait(6, Ignore Condition);
        If(Event Player.Ult_Matrix_Active == False);
            Set Move Speed(Event Player, 100);
            Set Damage Dealt(Event Player, 100);
            Destroy Effect(Event Player.Surge_VFX);
            Event Player.Surge_Active = False;
        End;
    }
}

rule("Combat Loop: Surge Lifesteal")
{
    event
    {
        Player Dealt Damage;
        All;
        Symmetra;
    }

    conditions
    {
        Event Player.Surge_Active == True;
    }

    actions
    {
        Heal(Event Player, Event Player, Event Damage * 0.300);
    }
}

rule("Cleanup: Death Reset")
{
    event
    {
        Player Died;
        All;
        Symmetra;
    }

    actions
    {
        Destroy Effect(Event Player.Surge_VFX);
        Event Player.Surge_Active = False;
        Set Move Speed(Event Player, 100);
        Set Damage Dealt(Event Player, 100);
    }
}

rule("Ultimate: Siege Matrix")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    conditions
    {
        Is Button Held(Event Player, Button(Ultimate)) == True;
        Ultimate Charge Percent(Event Player) == 100;
    }

    actions
    {
        Set Ultimate Charge(Event Player, 0);
        Event Player.Surge_CD = 0;
        Set Ability Cooldown(Event Player, Button(Ability 2), 0);
        Press Button(Event Player, Button(Ability 2));
        Destroy Effect(Event Player.Surge_VFX);
        Event Player.Ult_Matrix_Active = True;
        Event Player.Surge_Active = True;
        Event Player.Surge_Dur = 12;
        Chase Player Variable At Rate(Event Player, Surge_Dur, 0, 1, Destination and Rate);
        Set Move Speed(Event Player, 130);
        Set Damage Dealt(Event Player, 130);
        Create Effect(All Players(All Teams), Sparkles, Color(Aqua), Event Player, 2, Visible To Position and Radius);
        Event Player.Surge_VFX = Last Created Entity;
        Wait(12, Ignore Condition);
        Event Player.Ult_Matrix_Active = False;
        Event Player.Surge_Active = False;
        Set Move Speed(Event Player, 100);
        Set Damage Dealt(Event Player, 100);
        Destroy Effect(Event Player.Surge_VFX);
    }
}

rule("Aura: Command Aura Loop")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    conditions
    {
        Hero Of(Event Player) != Hero(Symmetra);
    }

    actions
    {
        Wait(0.250, Ignore Condition);
        Event Player.Aura_Check = False;
        If(Distance Between(Position Of(Event Player), Position Of(Value In Array(Players On Hero(Hero(Symmetra), Team Of(Event Player)), 0))) <= 15);
            If(Value In Array(Players On Hero(Hero(Symmetra), Team Of(Event Player)), 0).Surge_Active == True);
                Event Player.Aura_Check = True;
            End;
            If(Value In Array(Players On Hero(Hero(Symmetra), Team Of(Event Player)), 0).Ult_Matrix_Active == True);
                Event Player.Aura_Check = True;
            End;
        End;
        If(Event Player.Aura_Check == True);
            If(Event Player.Aura_Buffed == False);
                Event Player.Aura_Buffed = True;
                Set Move Speed(Event Player, 115);
                Add Health Pool To Player(Event Player, Shields, 75, True, True);
                Event Player.Bunker_Health_Pool = Last Created Health Pool;
                Start Heal Over Time(Event Player, Value In Array(Players On Hero(Hero(Symmetra), Team Of(Event Player)), 0), 9999, 30);
                Event Player.Bunker_HoT = Last Heal Over Time ID;
            End;
        Else;
            If(Event Player.Aura_Buffed == True);
                Event Player.Aura_Buffed = False;
                Set Move Speed(Event Player, 100);
                Remove All Health Pools From Player(Event Player);
                Stop Heal Over Time(Event Player.Bunker_HoT);
            End;
        End;
        Loop;
    }
}
