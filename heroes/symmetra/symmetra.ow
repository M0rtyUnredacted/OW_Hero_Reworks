variables
{
    player:
        0: Buff_Timer
        1: Buff_VFX_ID
        2: Slow_Timer
        3: Slow_Flag
        4: Buff_HUD_ID
}

rule("Init: Universal Physics State")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    actions
    {
        Event Player.Slow_Timer = 0;
        Event Player.Slow_Flag = False;
        Chase Player Variable At Rate(Event Player, Slow_Timer, 0, 1, Destination and Rate);
    }
}

rule("Init: Symmetra Overhaul & UI")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    actions
    {
        Event Player.Buff_Timer = 0;
        Event Player.Buff_VFX_ID = 0;
        Event Player.Buff_HUD_ID = 0;

        Chase Player Variable At Rate(Event Player, Buff_Timer, 0, 1, Destination and Rate);

        Create HUD Text(Event Player, Custom String("SYMMETRA REWORK ACTIVE"), Null, Null, Left, 0, Color(Aqua), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("Turrets: Resonance (+20% Dmg, +50% Proj Spd, 15% Slow on hit)"), Left, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("Turrets: Charges recharge 20% faster"), Left, 2, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
    }
}

rule("Ability 1: Turret Payload (Resonance Buff Activate)")
{
    // Fires on turret damage - Event Ability returns Button(Ability 1) for sentry turret hits
    event
    {
        Player Dealt Damage;
        All;
        Symmetra;
    }

    conditions
    {
        Event Ability == Button(Ability 1);
    }

    actions
    {
        If(Event Player.Buff_Timer <= 0);
            // Set timer FIRST - prevents expiration rule race condition where
            // Buff_VFX_ID going non-zero while Buff_Timer is still 0 would
            // immediately trigger the expiration rule and destroy the effect
            Event Player.Buff_Timer = 2;

            Set Damage Dealt(Event Player, 120);
            Set Projectile Speed(Event Player, 150);

            // Good Aura raised to waist height - visible when glancing down in FPS, less intrusive than a sphere
            Create Effect(All Players(All Teams), Good Aura, Color(Aqua), Add(Position Of(Event Player), Vector(0, 0.9, 0)), 1.0, Visible To Position and Radius);
            Event Player.Buff_VFX_ID = Last Created Entity;

            Create HUD Text(Event Player, Custom String("RESONANCE ACTIVE"), Custom String("{0}s", Round To Integer(Event Player.Buff_Timer, Up)), Null, Top, 1, Color(Aqua), Color(Aqua), Color(White), Visible To and String, Default Visibility);
            Event Player.Buff_HUD_ID = Last Text ID;

            Play Effect(All Players(All Teams), Good Explosion, Color(Aqua), Event Player, 2);
        End;

        // Rolling 2s window - each turret hit resets the timer
        Event Player.Buff_Timer = 2;
    }
}

rule("Ability 1: Turret Fast Recharge")
{
    // Each turret placement triggers this independently - each gets its own
    // 8s wait then adds one charge back (vs native ~10s = ~20% faster)
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    conditions
    {
        Is Using Ability 1(Event Player) == True;
    }

    actions
    {
        Wait(8, Ignore Condition);
        Set Ability Charge(Event Player, Button(Ability 1), Min(3, Ability Charge(Event Player, Button(Ability 1)) + 1));
    }
}

rule("Ability 1: Resonance Slow on Hit")
{
    event
    {
        Player Dealt Damage;
        All;
        Symmetra;
    }

    conditions
    {
        Event Player.Buff_Timer > 0;
    }

    actions
    {
        Victim.Slow_Timer = 2;
        If(Victim.Slow_Flag == False);
            Victim.Slow_Flag = True;
            Set Move Speed(Victim, 85);
        End;
    }
}

rule("System: Resonance Expiration (Victim Cleanse)")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    conditions
    {
        Event Player.Slow_Timer == 0;
        Event Player.Slow_Flag == True;
    }

    actions
    {
        Event Player.Slow_Flag = False;
        Set Move Speed(Event Player, 100);
    }
}

rule("System: Resonance Expiration (Symmetra Cleanse)")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    conditions
    {
        Event Player.Buff_Timer <= 0;
        Event Player.Buff_VFX_ID != 0;
    }

    actions
    {
        Set Damage Dealt(Event Player, 100);
        Set Projectile Speed(Event Player, 100);

        Destroy Effect(Event Player.Buff_VFX_ID);
        Event Player.Buff_VFX_ID = 0;

        Destroy HUD Text(Event Player.Buff_HUD_ID);
        Event Player.Buff_HUD_ID = 0;
    }
}

rule("System: Death Reset")
{
    event
    {
        Player Died;
        All;
        All;
    }

    actions
    {
        If(Hero Of(Event Player) == Hero(Symmetra));
            Set Damage Dealt(Event Player, 100);
            Set Projectile Speed(Event Player, 100);
            Event Player.Buff_Timer = 0;

            Destroy Effect(Event Player.Buff_VFX_ID);
            Event Player.Buff_VFX_ID = 0;

            Destroy HUD Text(Event Player.Buff_HUD_ID);
            Event Player.Buff_HUD_ID = 0;
        End;

        Set Move Speed(Event Player, 100);
        Event Player.Slow_Timer = 0;
        Event Player.Slow_Flag = False;
    }
}
