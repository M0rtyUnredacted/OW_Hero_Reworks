variables
{
    player:
        0: Buff_Timer
        1: Buff_VFX_ID
        2: Slow_Timer
        3: Slow_Flag
        4: Buff_HUD_ID
}

rule("Init: Universal Physics State")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    actions
    {
        Event Player.Slow_Timer = 0;
        Event Player.Slow_Flag = False;
        Chase Player Variable At Rate(Event Player, Slow_Timer, 0, 1, Destination and Rate);
    }
}

rule("Init: Symmetra Overhaul & UI")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    actions
    {
        Event Player.Buff_Timer = 0;
        Event Player.Buff_VFX_ID = 0;
        Event Player.Buff_HUD_ID = 0;

        Chase Player Variable At Rate(Event Player, Buff_Timer, 0, 1, Destination and Rate);

        Create HUD Text(Event Player, Custom String("SYMMETRA REWORK ACTIVE"), Null, Null, Left, 0, Color(Aqua), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("Turrets: Resonance (+20% Dmg, +50% Proj Spd, 15% Enemy Slow)"), Left, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("Kinetic Battery: Sec fire hits -1.5s all CDs"), Left, 2, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("Teleporter: Base CD increased to 14s"), Left, 3, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
    }
}

rule("Ability 2: Increase Base TP Cooldown")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    conditions
    {
        Is Using Ability 2(Event Player) == True;
    }

    actions
    {
        Wait(0.100, Ignore Condition);
        Set Ability Cooldown(Event Player, Button(Ability 2), 14);
    }
}

rule("Ability 1: Turret Payload (Resonance Buff & Slow)")
{
    event
    {
        Player Dealt Damage;
        All;
        Symmetra;
    }

    conditions
    {
        Event Damage < 50;
        Event Ability != Button(Primary Fire);
        Event Ability != Button(Secondary Fire);
        Event Ability != Button(Melee);
    }

    actions
    {
        If(Event Player.Buff_Timer <= 0);
            Set Damage Dealt(Event Player, 120);
            Set Projectile Speed(Event Player, 150);

            Create Effect(All Players(All Teams), Sparkles, Color(Yellow), Event Player, 2, Visible To Position and Radius);
            Event Player.Buff_VFX_ID = Last Created Entity;

            Create HUD Text(Event Player, Custom String("RESONANCE ACTIVE"), Custom String("{0}s REMAINING", Round To Integer(Event Player.Buff_Timer, Up)), Null, Top, 1, Color(Yellow), Color(Yellow), Color(White), Visible To and String, Default Visibility);
            Event Player.Buff_HUD_ID = Last Text ID;

            Play Effect(All Players(All Teams), Good Explosion, Color(Yellow), Event Player, 2);
            Small Message(Event Player, Custom String("RESONANCE ACTIVATED"));
        End;

        Event Player.Buff_Timer = 2;

        Victim.Slow_Timer = 2;
        If(Victim.Slow_Flag == False);
            Victim.Slow_Flag = True;
            Set Move Speed(Victim, 85);
        End;
    }
}

rule("System: Resonance Expiration (Victim Cleanse)")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    conditions
    {
        Event Player.Slow_Timer == 0;
        Event Player.Slow_Flag == True;
    }

    actions
    {
        Event Player.Slow_Flag = False;
        Set Move Speed(Event Player, 100);
    }
}

rule("System: Resonance Expiration (Symmetra Cleanse)")
{
    event
    {
        Ongoing - Each Player;
        All;
        Symmetra;
    }

    conditions
    {
        Event Player.Buff_Timer <= 0;
        Event Player.Buff_VFX_ID != 0;
    }

    actions
    {
        Set Damage Dealt(Event Player, 100);
        Set Projectile Speed(Event Player, 100);

        Destroy Effect(Event Player.Buff_VFX_ID);
        Event Player.Buff_VFX_ID = 0;

        Destroy HUD Text(Event Player.Buff_HUD_ID);
        Event Player.Buff_HUD_ID = 0;
    }
}

rule("Passive: Kinetic Battery (Secondary Fire CDR)")
{
    event
    {
        Player Dealt Damage;
        All;
        Symmetra;
    }

    conditions
    {
        Event Damage >= 50;
    }

    actions
    {
        Set Ability Cooldown(Event Player, Button(Ability 1), Max(0, Ability Cooldown(Event Player, Button(Ability 1)) - 1.500));
        Set Ability Cooldown(Event Player, Button(Ability 2), Max(0, Ability Cooldown(Event Player, Button(Ability 2)) - 1.500));
        Small Message(Event Player, Custom String("KINETIC BATTERY"));
    }
}

rule("System: Death Reset")
{
    event
    {
        Player Died;
        All;
        All;
    }

    actions
    {
        If(Hero Of(Event Player) == Hero(Symmetra));
            Set Damage Dealt(Event Player, 100);
            Set Projectile Speed(Event Player, 100);
            Event Player.Buff_Timer = 0;

            Destroy Effect(Event Player.Buff_VFX_ID);
            Event Player.Buff_VFX_ID = 0;

            Destroy HUD Text(Event Player.Buff_HUD_ID);
            Event Player.Buff_HUD_ID = 0;
        End;

        Set Move Speed(Event Player, 100);
        Event Player.Slow_Timer = 0;
        Event Player.Slow_Flag = False;
    }
}
