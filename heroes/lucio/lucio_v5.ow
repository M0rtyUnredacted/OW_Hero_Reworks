variables
{
    player:
        0: R
        1: M
        2: P
        3: A
        4: AB
}

rule("Lucio: Kinetic Rhythm V5 Init & 4Hz Loop")
{
    event
    {
        Ongoing - Each Player;
        All;
        Lúcio;
    }

    actions
    {
        Event Player.R  = 0;
        Event Player.M  = 0;
        Event Player.P  = 0;
        Event Player.A  = False;
        Event Player.AB = False;

        Create HUD Text(
            Event Player,
            Custom String("CHARGE: {0}  |  PEAK: {1}",
                Round To Integer(Event Player.R, Down),
                Round To Integer(Event Player.M, Down)),
            Null, Null,
            Top, 1,
            Color(Green), Color(White), Color(White),
            Visible To and String, Default Visibility
        );

        Create HUD Text(
            Event Player,
            Custom String("AURA: {0}  |  HEAL%: {1}%",
                First Of(Filtered Array(Array(Custom String("HEAL"), Custom String("SPEED")), Current Array Index == Event Player.A)),
                Round To Integer(50 + Event Player.R, Down)),
            Null, Null,
            Top, 2,
            Color(Aqua), Color(White), Color(White),
            Visible To and String, Default Visibility
        );

        Create HUD Text(
            Event Player,
            Custom String("STASIS: {0}s",
                Max(0, Round To Integer(Event Player.P, Up))),
            Null, Null,
            Top, 3,
            Color(Yellow), Color(White), Color(White),
            Visible To and String, Default Visibility
        );

        Create HUD Text(
            Event Player,
            Null, Null,
            Custom String("V5 ECONOMY: Gen = Dmg * (Speed/5.5). Cap 100 raw, 110 via Amp. Zero gen while still."),
            Left, 4,
            Color(White), Color(White), Color(Aqua),
            Visible To and String, Default Visibility
        );

        Create HUD Text(
            Event Player,
            Null, Null,
            Custom String("Heal Aura: -25/s. Speed Aura: -5/s above 50, 0 below. Amp: +10 overcap + 3s freeze."),
            Left, 5,
            Color(White), Color(White), Color(Aqua),
            Visible To and String, Default Visibility
        );

        While(True);

            Set Healing Dealt(Event Player, 50 + Event Player.R);

            Event Player.M = Max(Event Player.M, Event Player.R);

            If(Is Button Held(Event Player, Button(Ability 1)) == True);
                If(Event Player.AB == False);
                    If(Event Player.A == True);
                        Event Player.A = False;
                    Else;
                        Event Player.A = True;
                    End;
                End;
                Event Player.AB = True;
            Else;
                Event Player.AB = False;
            End;

            If(Event Player.P > 0);
                Event Player.P -= 0.250;
                If(Event Player.P < 0);
                    Event Player.P = 0;
                End;
            Else;
                If(Event Player.A == False);
                    Event Player.R -= 6.250;
                Else;
                    If(Event Player.R > 50);
                        Event Player.R -= 1.250;
                    End;
                End;
            End;

            Event Player.R = Max(0, Event Player.R);

            Wait(0.250, Ignore Condition);
        End;
    }
}

rule("Lucio: Kinetic Battery V5 (Damage -> Charge)")
{
    event
    {
        Player Dealt Damage;
        All;
        Lúcio;
    }

    conditions
    {
        Event Was Environment == False;
        Event Player.P == 0;
        Event Player.R < 100;
    }

    actions
    {
        Event Player.R += Event Damage * (Horizontal Speed Of(Event Player) / 5.500);
        If(Event Player.R > 100);
            Event Player.R = 100;
        End;
    }
}

rule("Lucio: The Drop V5 (Environmental Kill)")
{
    event
    {
        Player Earned Elimination;
        All;
        Lúcio;
    }

    conditions
    {
        Event Was Environment == True;
    }

    actions
    {
        Event Player.R += 50;
        If(Event Player.R > 100);
            Event Player.R = 100;
        End;
        Play Effect(All Players(All Teams), Ring Explosion Sound, Color(White), Event Player, 100);
    }
}

rule("Lucio: Sound Barrier Resonance V5")
{
    event
    {
        Ongoing - Each Player;
        All;
        Lúcio;
    }

    conditions
    {
        Is Using Ultimate(Event Player) == True;
    }

    actions
    {
        Event Player.P = 3.000;
    }
}

rule("Lucio: Death State Reset V5")
{
    event
    {
        Player Died;
        All;
        Lúcio;
    }

    actions
    {
        Event Player.R  = 0;
        Event Player.P  = 0;
        Event Player.A  = False;
        Event Player.AB = False;
    }
}

rule("Lucio: Amp It Up V5 (Stasis Overcap)")
{
    event
    {
        Ongoing - Each Player;
        All;
        Lúcio;
    }

    conditions
    {
        Is Using Ability 2(Event Player) == True;
    }

    actions
    {
        Event Player.R += 10;
        If(Event Player.R > 110);
            Event Player.R = 110;
        End;
        Event Player.P = 3.000;
    }
}
