variables
{
    player:
        0: R
        1: H
        2: M
        3: P
}

rule("Lucio: Kinetic Rhythm Init & 4Hz Loop")
{
    event
    {
        Ongoing - Each Player;
        All;
        Lúcio;
    }

    actions
    {
        Event Player.R = 0;
        Event Player.H = 0;
        Event Player.M = 0;
        Event Player.P = 0;

        Create HUD Text(Event Player, Custom String("LIVE CHARGE: {0}", Round To Integer(Event Player.R, Down)), Null, Null, Top, 1, Color(Green), Color(White), Color(White), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Custom String("PEAK CHARGE: {0}", Round To Integer(Event Player.M, Down)), Null, Null, Top, 2, Color(Purple), Color(White), Color(White), Visible To and String, Default Visibility);

        Create HUD Text(Event Player, Null, Null, Custom String("KINETIC REWORK: Dmg generation scales directly with your Velocity."), Left, 3, Color(White), Color(White), Color(Aqua), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("High velocity (momentum) builds charge. >50 decays at 8% per tick."), Left, 4, Color(White), Color(White), Color(Aqua), Visible To and String, Default Visibility);
        Create HUD Text(Event Player, Null, Null, Custom String("Amp/Beat sets floor to 40 & pauses decay for 3s. Uncapped scaling."), Left, 5, Color(White), Color(White), Color(Aqua), Visible To and String, Default Visibility);

        While(True);
            If(Event Player.R <= 50);
                Event Player.H = Event Player.R * 2;
            Else;
                Event Player.H = 100 + (Event Player.R - 50);
            End;
            Set Healing Dealt(Event Player, Event Player.H);

            Event Player.M = Max(Event Player.M, Event Player.R);

            If(Event Player.P > 0);
                Event Player.P -= 0.250;
            Else;
                Event Player.R += Max(0, (Horizontal Speed Of(Event Player) - 5.500) * 0.250);

                If(Event Player.R > 50);
                    Event Player.R -= (Event Player.R * 0.080);
                Else;
                    Event Player.R -= 0.375;
                End;
            End;

            Event Player.R = Max(0, Event Player.R);
            Wait(0.250, Ignore Condition);
        End;
    }
}

rule("Lucio: Kinetic Battery (Damage Handlers)")
{
    event
    {
        Player Dealt Damage;
        All;
        Lúcio;
    }

    conditions
    {
        Event Was Environment == False;
    }

    actions
    {
        Event Player.R += Event Damage * (Horizontal Speed Of(Event Player) / 5.500);
    }
}

rule("Lucio: The Drop (Environmental Kill)")
{
    event
    {
        Player Earned Elimination;
        All;
        Lúcio;
    }

    conditions
    {
        Event Was Environment == True;
    }

    actions
    {
        Event Player.R += 50;
        Play Effect(All Players(All Teams), Ring Explosion Sound, Color(White), Event Player, 100);
    }
}

rule("Lucio: Sound Barrier Resonance")
{
    event
    {
        Ongoing - Each Player;
        All;
        Lúcio;
    }

    conditions
    {
        Is Using Ultimate(Event Player) == True;
    }

    actions
    {
        Event Player.R = Max(40, Event Player.R);
        Event Player.P = 3.000;
    }
}

rule("Lucio: Death State Reset")
{
    event
    {
        Player Died;
        All;
        Lúcio;
    }

    actions
    {
        Event Player.R = 0;
    }
}

rule("Lucio: Amp Override")
{
    event
    {
        Ongoing - Each Player;
        All;
        Lúcio;
    }

    conditions
    {
        Is Using Ability 2(Event Player) == True;
    }

    actions
    {
        Event Player.R = Max(40, Event Player.R);
        Event Player.P = 3.000;
    }
}
