{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node tools/validate.js:*)",
      "Bash(node tools/gen-api-docs.js:*)",
      "Bash(tools/setup.sh:*)"
    ]
  }
}
