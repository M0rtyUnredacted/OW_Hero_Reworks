# Miscellaneous rules that support multiple abilities.
# Examples: respawn cleanup, cross-ability interactions,
# variable resets that apply globally.
# ============================================================

rule("Utility - On Respawn Cleanup")
{
    event
    {
        Player Joined Match;
        All;
        All;
    }

    actions
    {
        # Reset all player variables to defaults on respawn/rejoin
