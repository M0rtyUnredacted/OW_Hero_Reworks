// ============================================================
// HERO: Ana   (REPLACE every "Ana" / Hero(Ana) with the reworked hero)
// REWORK VERSION: v1.0
// LAST UPDATED: YYYY-MM-DD
// DESCRIPTION: One sentence summary of what this rework does.
// ============================================================
// HOW TO USE: copy this whole file, open Workshop > Settings >
// Workshop editor, click the paste/import icon, then start the game.
//
// SYNTAX RULES (the in-game importer is strict):
//   - Top-level comments use '//' (like these lines).
//   - Comments inside a rule are quoted strings placed directly
//     before an action or condition: "explains the next line"
//   - Never use '#' comments.
//   - Run `node tools/validate.js` before committing.
// ============================================================

settings
{
	main
	{
		Description: "Ana Rework v1.0 - one line pitch. Source: github.com/M0rtyUnredacted/OW_Hero_Reworks"
		Mode Name: "Ana Rework"
	}

	lobby
	{
		Max Team 1 Players: 5
		Max Team 2 Players: 5
	}

	modes
	{
		Skirmish
		{
		}

		General
		{
			Game Mode Start: Immediately
			Hero Limit: Off
			Respawn Time Scalar: 30%
		}
	}

	heroes
	{
		General
		{
			Ana
			{
				Healing Dealt: 100%
			}
		}
	}
}

variables
{
	global:
		0: BuffDuration
		1: BuffDamagePercent

	player:
		0: BuffActive
		1: BuffEffect
		2: HudTexts
		3: LoopIndex
}

subroutines
{
	0: ResetReworkState
}

// ============================================================
// SETUP
// ============================================================

rule("Setup: Lobby Tunables")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"Tunables live in Settings > Workshop so testers can rebalance without editing code."
		Global.BuffDuration = Workshop Setting Real(Custom String("Ana Rework"), Custom String("Buff duration (seconds)"), 3, 0.5, 10, 0);
		Global.BuffDamagePercent = Workshop Setting Integer(Custom String("Ana Rework"), Custom String("Buff damage dealt (%)"), 120, 100, 300, 1);
		Disable Inspector Recording;
	}
}

rule("Setup: Hero HUD (runs each time a player becomes the hero)")
{
	event
	{
		Ongoing - Each Player;
		All;
		Ana;
	}

	actions
	{
		Call Subroutine(ResetReworkState);
		Create HUD Text(Event Player, Null, Null, Custom String("Ana Rework v1.0 - one line summary of the changes"), Left, 0, Color(White), Color(White), Color(Aqua), Visible To and String, Default Visibility);
		Modify Player Variable(Event Player, HudTexts, Append To Array, Last Text ID);
		Create HUD Text(Event Player, Null, Null, Custom String("Ability 2: grants a short damage buff"), Left, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Modify Player Variable(Event Player, HudTexts, Append To Array, Last Text ID);
	}
}

// ============================================================
// ABILITY 2 - example: timed self-buff on cast
// Pattern: edge-triggered condition + Wait, no chased timers in conditions.
// ============================================================

rule("Ability 2: Buff On Cast")
{
	event
	{
		Ongoing - Each Player;
		All;
		Ana;
	}

	conditions
	{
		Is Using Ability 2(Event Player) == True;
	}

	actions
	{
		Event Player.BuffActive = True;
		Set Damage Dealt(Event Player, Global.BuffDamagePercent);
		Create Effect(All Players(All Teams), Good Aura, Color(Aqua), Event Player, 0.750, Visible To Position and Radius);
		Event Player.BuffEffect = Last Created Entity;
		Wait(Global.BuffDuration, Ignore Condition);
		"Only clear if nothing else (death, hero swap) already did."
		If(Event Player.BuffActive);
			Event Player.BuffActive = False;
			Set Damage Dealt(Event Player, 100);
			Destroy Effect(Event Player.BuffEffect);
		End;
	}
}

// ============================================================
// LIFECYCLE / CLEANUP
// ============================================================

rule("Lifecycle: Reset On Death")
{
	event
	{
		Player Died;
		All;
		Ana;
	}

	actions
	{
		Event Player.BuffActive = False;
		Set Damage Dealt(Event Player, 100);
		Destroy Effect(Event Player.BuffEffect);
	}
}

rule("Lifecycle: Clean Up After Swapping Off The Hero")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Hero Of(Event Player) != Hero(Ana);
		Count Of(Event Player.HudTexts) > 0;
	}

	actions
	{
		Call Subroutine(ResetReworkState);
	}
}

rule("Sub: Reset Rework State")
{
	event
	{
		Subroutine;
		ResetReworkState;
	}

	actions
	{
		"Destroy every HUD text this player owns, then reset modifiers to baseline."
		For Player Variable(Event Player, LoopIndex, 0, Count Of(Event Player.HudTexts), 1);
			Destroy HUD Text(Event Player.HudTexts[Event Player.LoopIndex]);
		End;
		Event Player.HudTexts = Empty Array;
		Event Player.BuffActive = False;
		Destroy Effect(Event Player.BuffEffect);
		Set Damage Dealt(Event Player, 100);
	}
}

// ============================================================
// END OF SCRIPT - Ana Rework v1.0
// ============================================================
