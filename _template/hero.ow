# === SETTINGS ===
# Configures the game mode, hero availability, and lobby rules.
# Adjust these to match the intended test environment.

settings
{
    main
    {
        Description: "[Hero Name] Rework - v1.0"
        Mode Name: "[Hero Name] Rework"
    }

    modes
    {
        # Replace with the desired game mode, e.g. Skirmish, Deathmatch
        Skirmish
        {
            enabled maps
            {
                Skirmish
            }
        }
    }

    heroes
    {
        Team 1
        {
            # Restrict to the reworked hero so testers use the right character
            # Example: disabled heroes { ... }
        }
    }
}


# === GLOBAL VARIABLES ===
# Variables shared across the entire match (not tied to a specific player).
# Use PascalCase names. Assign all numeric constants here with a comment
# explaining the value — never use bare numbers in rules below.

variables
{
    global:
        # Example:
        # 0: ReworkVersion              # Used in HUD display
        # 1: SomeConstant               # Description of what this number means
}


# === PLAYER VARIABLES ===
# Variables tied to individual players (cooldowns, counters, state flags).
# Use PascalCase names.

variables
{
    player:
        # Example:
        # 0: AbilityCharge              # Current charges for the modified ability
        # 1: IsAbilityActive            # True while the ability is in use
}


# === SUBROUTINES ===
# Named action blocks that can be called from multiple rules.
# Add one entry per subroutine, then define the matching rule below.

subroutines
{
    # Example:
    # 0: ResetAbilityState
}


# ============================================================
# === INITIALIZATION ===
# Runs once when the match starts.
# Sets all global and player variable defaults.
# ============================================================

rule("Init - [Hero Name] Rework")
{
    event
    {
        Ongoing - Global;
    }

    actions
    {
        # Set global constants
        # Global Variable(ReworkVersion) = 1.0;

        # Set player variable defaults for all players
        # For All Players(All Teams) Do:
        #   Set Player Variable([Hero Name] player, AbilityCharge, 0);
    }
}


# ============================================================
# === ABILITY: [ABILITY NAME] ===
# Describe what this ability does in the rework (plain English).
# Add as many rules as needed — one per distinct trigger or effect.
# Rule naming format: "[Ability] - [What this rule does]"
# ============================================================

rule("[Ability Name] - Detect Activation")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    conditions
    {
        # Condition that detects the ability being used
        # Example: Is Button Held(Event Player, Button(Ability 1)) == True;
    }

    actions
    {
        # Actions to perform when the ability fires
    }
}

rule("[Ability Name] - Apply Effect")
{
    event
    {
        Ongoing - Each Player;
        All;
        All;
    }

    conditions
    {
        # Condition(s) that trigger the effect
    }

    actions
    {
        # The actual gameplay effect (damage, movement, healing, etc.)
    }
}

rule("[Ability Name] - Reset on Death")
{
    event
    {
        Player Died;
        All;
        All;
    }

    actions
    {
        # Clean up any active effects and reset variables when the player dies
    }
}


